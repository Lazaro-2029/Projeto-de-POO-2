<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane prefHeight="460.0" prefWidth="600.0" style="-fx-background-color: #604848;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.editora.controller.DetalheObraController">
  <children>
    <Label alignment="CENTER" layoutX="100.0" layoutY="15.0" prefWidth="400.0" style="-fx-font-size:22; -fx-font-weight:bold;" text="DETALHE DA OBRA" textFill="white" />
    <Label layoutX="40.0" layoutY="60.0" text="Título:" textFill="#ddcccc" />
    <Label fx:id="lblTitulo" layoutX="150.0" layoutY="60.0" prefWidth="400.0" style="-fx-font-size:15; -fx-font-weight:bold;" textFill="white" />
    <Label layoutX="40.0" layoutY="95.0" text="Autor:" textFill="#ddcccc" />
    <Label fx:id="lblAutor" layoutX="150.0" layoutY="95.0" prefWidth="400.0" textFill="white" />
    <Label layoutX="40.0" layoutY="125.0" text="Gênero:" textFill="#ddcccc" />
    <Label fx:id="lblGenero" layoutX="150.0" layoutY="125.0" prefWidth="200.0" textFill="white" />
    <Label layoutX="40.0" layoutY="155.0" text="Ano:" textFill="#ddcccc" />
    <Label fx:id="lblAno" layoutX="150.0" layoutY="155.0" prefWidth="100.0" textFill="white" />
    <Label layoutX="40.0" layoutY="185.0" text="Status:" textFill="#ddcccc" />
    <Label fx:id="lblStatus" layoutX="150.0" layoutY="185.0" prefWidth="200.0" style="-fx-font-weight:bold;" textFill="white" />
    <Label layoutX="40.0" layoutY="215.0" text="Avaliador:" textFill="#ddcccc" />
    <Label fx:id="lblAvaliador" layoutX="150.0" layoutY="215.0" prefWidth="400.0" textFill="white" />
    <Label layoutX="40.0" layoutY="245.0" text="Avaliado em:" textFill="#ddcccc" />
    <Label fx:id="lblDataAval" layoutX="150.0" layoutY="245.0" prefWidth="200.0" textFill="white" />
    <Button fx:id="btAprovar" layoutX="40.0" layoutY="320.0" prefHeight="39.0" prefWidth="155.0" style="-fx-background-color:#2d7a2d; -fx-text-fill:white; -fx-font-weight:bold;" text="✔ APROVAR" />
    <Button fx:id="btReprovar" layoutX="210.0" layoutY="320.0" prefHeight="39.0" prefWidth="155.0" style="-fx-background-color:#8b0000; -fx-text-fill:white; -fx-font-weight:bold;" text="✘ REPROVAR" />

    <!-- Área de atribuição (apenas para gerente) -->
    <Label layoutX="40.0" layoutY="295.0" text="CPF do Avaliador:" textFill="#ddcccc" />
    <TextField fx:id="tfCpfAvaliador" layoutX="40.0" layoutY="315.0" prefWidth="200.0" promptText="CPF do avaliador" />
    <Button fx:id="btAtribuir" layoutX="255.0" layoutY="315.0" prefHeight="33.0" prefWidth="130.0" style="-fx-background-color:white; -fx-text-fill:#604848;" text="Atribuir Avaliador" />

    <Button fx:id="btVoltar" layoutX="230.0" layoutY="395.0" prefHeight="39.0" prefWidth="140.0" style="-fx-background-color:white; -fx-text-fill:#604848;" text="← Voltar" />
  </children>
</Pane>
