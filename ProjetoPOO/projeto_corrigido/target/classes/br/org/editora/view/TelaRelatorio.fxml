<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #48484814;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.editora.controller.RelatorioController">
  <children>
    <!-- Menu lateral -->
    <Region layoutX="0.0" layoutY="0.0" prefHeight="400.0" prefWidth="200.0" style="-fx-background-color: #604848;" />
    <Label layoutX="10.0" layoutY="20.0" style="-fx-font-size:16; -fx-font-weight:bold;" text="EDITORA" textFill="white" />
    <Label layoutX="10.0" layoutY="50.0" style="-fx-font-size:12;" text="PUBLIXY" textFill="#ddcccc" />
    <Button fx:id="btO" layoutX="15.0" layoutY="130.0" prefHeight="35.0" prefWidth="165.0" style="-fx-background-color:transparent; -fx-text-fill:white; -fx-border-color:#7a5a5a;" text="Obras" />
    <Button fx:id="btA" layoutX="15.0" layoutY="175.0" prefHeight="35.0" prefWidth="165.0" style="-fx-background-color:transparent; -fx-text-fill:white; -fx-border-color:#7a5a5a;" text="Autores" />
    <Button fx:id="btV" layoutX="15.0" layoutY="220.0" prefHeight="35.0" prefWidth="165.0" style="-fx-background-color:transparent; -fx-text-fill:white; -fx-border-color:#7a5a5a;" text="Avaliadores" />
    <Button fx:id="btR" layoutX="15.0" layoutY="265.0" prefHeight="35.0" prefWidth="165.0" style="-fx-background-color:#7a5a5a; -fx-text-fill:white;" text="Relatórios" />
    <Button fx:id="btS" layoutX="15.0" layoutY="348.0" prefHeight="35.0" prefWidth="165.0" style="-fx-background-color:#3a2828; -fx-text-fill:white;" text="Finalizar Sessão" />

    <!-- Conteúdo -->
    <Label layoutX="215.0" layoutY="10.0" style="-fx-font-size:16; -fx-font-weight:bold;" text="RELATÓRIO DE OBRAS" textFill="#604848" />

    <Label layoutX="215.0" layoutY="55.0" text="Data Inicial:" textFill="#604848" />
    <DatePicker fx:id="dataIn" layoutX="215.0" layoutY="75.0" prefWidth="160.0" />

    <Label layoutX="390.0" layoutY="55.0" text="Data Final:" textFill="#604848" />
    <DatePicker fx:id="dataFi" layoutX="390.0" layoutY="75.0" prefWidth="160.0" />

    <Button fx:id="btGerR" layoutX="250.0" layoutY="125.0" prefHeight="39.0" prefWidth="200.0" style="-fx-background-color:#604848; -fx-text-fill:white; -fx-font-weight:bold;" text="Gerar Relatório" />

    <!-- Resumo rápido -->
    <Label layoutX="215.0" layoutY="180.0" style="-fx-font-weight:bold;" text="Resumo Geral:" textFill="#604848" />
    <Label fx:id="lblTotalObras" layoutX="215.0" layoutY="205.0" textFill="#604848" />
    <Label fx:id="lblTotalAutores" layoutX="215.0" layoutY="228.0" textFill="#604848" />
    <Label fx:id="lblTotalAvaliadores" layoutX="215.0" layoutY="251.0" textFill="#604848" />
    <Label fx:id="lblStatusRes" layoutX="215.0" layoutY="274.0" prefWidth="335.0" textFill="#604848" />

    <Button fx:id="btRelAnt" layoutX="215.0" layoutY="320.0" prefHeight="35.0" prefWidth="340.0" style="-fx-background-color:#white; -fx-border-color:#604848; -fx-text-fill:#604848;" text="Ver Obras por Status" />
  </children>
</Pane>
